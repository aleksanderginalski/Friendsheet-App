{
  "permissions": {
    "allow": [
      "Edit(.claude/skills/**)",
      "Edit(CLAUDE.md)",
      "Edit(MULTI_AGENT_ARCHITECTURE.md)",
      "Edit(docs/BACKLOG.md)",
      "Edit(docs/TEST_CASES.md)",
      "Edit(CHANGELOG.md)",
      "Edit(README.md)",
      "Edit(docs/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart format:*)",
      "Write(.claude/current_task.md)",
      "Write(docs/**)",
      "Bash(touch .claude/*)",
      "Bash(echo * > .claude/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [{ "type": "command", "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.12-windows-x86_64-none/python.exe C:/Programowanie/Friendsheet-App/tools/observability/log_agent.py" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.12-windows-x86_64-none/python.exe C:/Programowanie/Friendsheet-App/tools/observability/log_agent_from_prompt.py" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.12-windows-x86_64-none/python.exe C:/Programowanie/Friendsheet-App/tools/observability/log_stop.py" }]
      }
    ]
  }
}
