rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /activity_categories/{categoryId} {
      allow read: if isAuthenticated() && resource.data.isGlobal == true;
      allow create: if isAuthenticated() &&
                       request.resource.data.isGlobal == false &&
                       isOwner(request.resource.data.userId);
    }

    match /users/{userId}/activity_categories/{categoryId} {
      allow read, delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId);
    }

    match /users/{userId}/meetings/{meetingId} {
      allow read, delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId);
    }

    match /users/{userId}/persons/{personId} {
      allow read, delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId);
    }

    match /users/{userId}/friend_groups/{groupId} {
      // Path-based userId check — required for list queries (resource.data unavailable)
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // invitation_codes root collection removed — replaced by
    // users/{uid}/sharing_tokens subcollection (FEATURE-012, US-089)

    // Collection group rule — allows any authenticated user to read a token by value.
    // Required for cross-user token validation in US-090 (A validates C's token).
    // Tokens contain no PII; they are random 6-char strings with 24h TTL.
    match /{path=**}/sharing_tokens/{tokenId} {
      allow read: if isAuthenticated();
    }

    match /users/{userId}/sharing_tokens/{tokenId} {
      // Token owner (C) can create and delete their own tokens.
      allow create, delete: if isAuthenticated() && isOwner(userId);
      // Token owner can update freely.
      allow update: if isAuthenticated() && isOwner(userId);
      // Any authenticated user (A) may mark a token as used after linking.
      // Only isUsed may change, only false → true, no other fields touched.
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed'])
                    && request.resource.data.isUsed == true
                    && resource.data.isUsed == false;
    }

    match /users/{userId}/pending_meetings/{packageId} {
      // Recipient reads and deletes their own packages.
      allow read, delete: if isAuthenticated() && isOwner(userId);
      // Any authenticated user may create a package (linkedUserId validated in service layer).
      allow create: if isAuthenticated();
    }

    match /users/{userId}/dashboard_config/{configId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
  }
}